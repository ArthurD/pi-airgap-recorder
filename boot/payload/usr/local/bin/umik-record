#!/bin/sh
# umik-record - continuous segmented capture from a USB measurement mic
# (miniDSP UMIK-1 or RODE NT1 5th Gen out of the box; see UMIK_VID below).
#
# Design notes:
#   * The UMIK-1's USB product string embeds its per-unit calibration gain
#     (e.g. "Umik-1  Gain:18dB"), so the ALSA card *name* differs between
#     units. We therefore resolve the card by USB VID:PID, never by name.
#   * Recording is segmented so that an unannounced power cut can damage at
#     most the in-flight segment. Every completed segment is closed and
#     synced by arecord on rotation.
#   * The Pi 4B has no built-in RTC and no network, so sessions are ordered
#     by a persistent counter on the data partition. Wall time is recorded
#     but marked trusted only on GPS-anchored evidence: a GPS sync this
#     boot, or a DS3231 RTC that GPS disciplined on an earlier boot.

set -eu

# The UMIK-1 exists in at least two hardware revisions - an older mini-USB one
# and a newer USB-C one - and they do not necessarily share a product ID. So we
# match on the *vendor* ID and take any audio device it presents.
#
# UMIK_VID is a LIST so that more than one mic can live in the field kit and be
# swapped at will with no config change: whichever one is plugged in is the one
# that gets recorded, and session.json records which it was. Space- or
# comma-separated, because a comma is what people type.
#
# Nothing below this line is mic-specific: the format probe asks the hardware
# what it accepts, and the calibration gain simply reads "unknown" when the
# product string has none. So the vendor is a knob, not a premise:
#   UMIK_VID="2752 19f7"  the shipped default (miniDSP, RODE)
#   UMIK_VID=<vvvv>       record only from this USB vendor's device
#   UMIK_VID=any          record from the first USB audio capture device found
UMIK_VID=${UMIK_VID:-"2752 19f7"}
# Narrows the match to one product. Only honoured when UMIK_VID names exactly
# ONE vendor: a product ID is unique only within a vendor, so pairing it with a
# list (or with "any") would mean something different for each entry. Ignored,
# loudly, otherwise.
UMIK_PID=${UMIK_PID:-}

# Friendly mic label for the log line and session.json. Purely cosmetic - an
# unrecognised vendor just gets its own USB strings - so adding a mic here is
# one case arm and nothing else in the file needs to know about it.
mic_label() { # <vvvv> <product> <manufacturer>
    case "$1" in
        2752) printf 'miniDSP UMIK-1' ;;        # UMIK-1, both hardware revs
        19f7) case "$2" in                      # RODE: NT1 5th Gen and kin
                  unknown|'')        printf 'RODE' ;;
                  RODE*|Rode*|rode*) printf '%s' "$2" ;;
                  *)                 printf 'RODE %s' "$2" ;;
              esac ;;
        *)    case "$3" in                      # "<manufacturer> <product>"
                  unknown|'') printf '%s' "$2" ;;
                  *)          printf '%s %s' "$3" "$2" ;;
              esac ;;
    esac
}

# Per-vendor capture preference: what to ASK the hardware for, best first.
# This does not decide anything - the probe still asks the device what it will
# actually accept - it only sets the ORDER in which we ask, so a mic that
# cannot do its first choice quietly lands on the next. Two lines out:
# preferred formats, then preferred sample rates. UMIK_FORMAT and UMIK_RATE
# override either list. Adding a mic is one case arm, same as mic_label().
mic_prefs() { # <vvvv> -> line 1: formats, line 2: rates
    case "$1" in
        # miniDSP: byte-for-byte what this recorder has always asked for. A
        # measurement mic is calibrated at one rate, and every UMIK-1 session
        # in the archive so far is 48k/24-bit integer - leave it alone so old
        # and new recordings stay directly comparable.
        2752) printf 'S24_3LE S32_LE S16_LE FLOAT_LE\n48000\n' ;;
        # RODE: capture at the best the mic will give, float first and the
        # highest rate first. That is a deliberate quality-over-storage
        # choice, and it is not a small one: mono 32-bit float at 192 kHz is
        # 768 KB/s - ~2.8 GB/hour, ~66 GB/day, and double all of it if the mic
        # enumerates as stereo. A 128GB card is then under two days, not ten.
        # The rate list IS the knob: drop 192000 here, or set UMIK_RATE, and
        # the cost falls with it.
        19f7) printf 'FLOAT_LE S32_LE S24_3LE S16_LE\n192000 96000 48000\n' ;;
        # Anything else: the conservative default. An unknown mic is not worth
        # filling a card over before someone has decided it should be.
        *)    printf 'S24_3LE S32_LE S16_LE FLOAT_LE\n48000\n' ;;
    esac
}

# Storage: a USB drive mounted at /data/usb by umik-usb-detect wins, so
# recordings can be pulled, copied anywhere, and the stick put back. No
# stick -> the SD card. UMIK_DATA_DIR overrides both.
DATA_DIR=${UMIK_DATA_DIR:-}
if [ -z "$DATA_DIR" ]; then
    if mountpoint -q /data/usb 2>/dev/null; then
        DATA_DIR=/data/usb/recordings
        STORAGE=usb
    else
        DATA_DIR=/data/recordings
        STORAGE=sd
    fi
else
    STORAGE=custom
fi

# --- persistent activity log ------------------------------------------------
# journald is volatile (RAM) on this box, so mirror the interesting events to
# a plain text file on the SAME medium as the recordings - whatever you pull
# and read on a Mac carries its own log. Rotates at ~5MB, keeps one previous.

LOGDIR="$(dirname "$DATA_DIR")/logs"
LOGFILE="${LOGDIR}/umik.log"
BOOTID=$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)

# log() MUST be defined before applog's first call: under set -e an undefined
# function is a fatal 127, killing the service before it logs anything.
log() { echo "umik-record: $*" >&2; }

applog() {
    log "$*"
    mkdir -p "$LOGDIR" 2>/dev/null || return 0
    [ -w "$LOGDIR" ] || return 0
    # "|| true" matters: under set -e a failed rotation mv would otherwise
    # kill the whole recorder from inside its own logging function.
    if [ -f "$LOGFILE" ] && [ "$(wc -c < "$LOGFILE")" -gt 5242880 ]; then
        mv -f "$LOGFILE" "${LOGFILE}.1" 2>/dev/null || true
    fi
    printf '%s boot=%s up=%3ss %s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$BOOTID" \
        "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo '?')" "$*" \
        >> "$LOGFILE" 2>/dev/null || true
}

# A restart-loop with no FATAL line was observed in the field once: the shell
# died between two applog calls and left no trace. Whatever the cause, an
# abnormal exit must always leave a line in the activity log.
trap 'rc=$?; [ "$rc" -eq 0 ] || applog "ABNORMAL EXIT status=${rc}"' EXIT

applog "=== service start: storage=${STORAGE} data=${DATA_DIR} ==="
# RATE is NOT set here any more: it is whatever the probe negotiates from the
# mic's preference list (see mic_prefs), so that a 192 kHz-capable mic is not
# pinned to 48k by a default written for a different one. UMIK_RATE still
# overrides, and still accepts a single value.
CHANNELS=${UMIK_CHANNELS:-1}
SEGMENT=${UMIK_SEGMENT_SECONDS:-600}
WAIT_SECS=${UMIK_WAIT_SECONDS:-60}

# --- locate the mic ---------------------------------------------------------

# Normalise the vendor list once: "2752,19f7" and "2752 19f7" must behave the
# same, because getting that silently wrong presents as an unexplained FATAL
# an hour into a field deployment.
VID_LIST=$(printf '%s' "$UMIK_VID" | tr ',' ' ')
VID_COUNT=0
for v in $VID_LIST; do VID_COUNT=$((VID_COUNT + 1)); done

if [ -n "$UMIK_PID" ] && { [ "$UMIK_VID" = "any" ] || [ "$VID_COUNT" -ne 1 ]; }; then
    applog "WARNING: ignoring UMIK_PID=${UMIK_PID} - it only narrows a single-vendor UMIK_VID, and this one is '${UMIK_VID}'"
    UMIK_PID=""
fi

# Does a "vvvv:pppp" usbid belong to one of the mics we want?
# UMIK_VID=any matches any USB audio device - /proc/asound only lists sound
# cards in the first place, so "any" still cannot select a keyboard.
id_matches() {
    if [ "$UMIK_VID" = "any" ]; then
        return 0
    fi
    for v in $VID_LIST; do
        if [ -n "$UMIK_PID" ]; then
            case "$1" in "${v}:${UMIK_PID}") return 0 ;; esac
        else
            case "$1" in "${v}:"*) return 0 ;; esac
        fi
    done
    return 1
}

# Echoes "<card-index> <usbid>" for the FIRST sound card matching ANY listed
# vendor. With one mic plugged in, that is the mic, whichever one it is. With
# two, the lower ALSA card index wins - arbitrary but deterministic, and
# session.json says which one it picked.
find_card() {
    for u in /proc/asound/card*/usbid; do
        [ -r "$u" ] || continue
        _id=$(cat "$u")
        id_matches "$_id" || continue
        c=${u%/usbid}
        echo "${c##*/card} ${_id}"
        return 0
    done
    return 1
}

# These strings come from the USB device itself - untrusted input. They are
# only ever data here (heredocs substitute values without re-evaluating them),
# but strip JSON-breaking and control characters before storing them.
usb_str() { # <sysfs-dir> <attribute>
    _s=$(cat "${1}${2}" 2>/dev/null | tr -cd 'A-Za-z0-9 ._:()+-' | cut -c1-64)
    [ -n "$_s" ] || _s="unknown"
    printf '%s\n' "$_s"
}

# Product, manufacturer and serial for the exact device that owns the card we
# picked - all three from the SAME sysfs entry, so they cannot describe three
# different gadgets. This takes the resolved usbid rather than re-running
# id_matches: /sys/bus/usb/devices lists every USB device, so under
# UMIK_VID=any a looser match here would happily report a hub's or keyboard's
# strings as the microphone's.
#
# Echoes three lines: product, manufacturer, serial.
find_usb_strings() { # <vvvv:pppp>
    for d in /sys/bus/usb/devices/*/; do
        [ -r "${d}idVendor" ] && [ -r "${d}idProduct" ] || continue
        [ "$(cat "${d}idVendor"):$(cat "${d}idProduct")" = "$1" ] || continue
        usb_str "$d" product
        usb_str "$d" manufacturer
        usb_str "$d" serial
        return 0
    done
    return 1
}

# udev may not have settled when we start; wait rather than fail the unit.
elapsed=0
while ! FOUND=$(find_card); do
    if [ "$elapsed" -ge "$WAIT_SECS" ]; then
        if [ "$UMIK_VID" = "any" ]; then
            applog "FATAL: no USB audio capture device after ${WAIT_SECS}s - is the mic plugged into a BLACK USB 2.0 port?"
        else
            applog "FATAL: no device from USB vendor(s) ${VID_LIST} after ${WAIT_SECS}s - is the mic plugged into a BLACK USB 2.0 port? (set UMIK_VID=any to accept any USB mic)"
        fi
        for u in /proc/asound/card*/usbid; do
            [ -r "$u" ] && applog "  saw sound device: $(cat "$u")"
        done
        log "(the UMIK cable is USB-C at the mic, USB-A at the Pi; the Pi's USB-C is power-only)"
        exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done
CARD=${FOUND% *}
USBID=${FOUND#* }
VENDOR_ID=${USBID%:*}
PRODUCT_ID=${USBID#*:}

USB_STRINGS=$(find_usb_strings "$USBID" 2>/dev/null || true)
PRODUCT=$(printf '%s\n' "$USB_STRINGS" | sed -n 1p)
MANUFACTURER=$(printf '%s\n' "$USB_STRINGS" | sed -n 2p)
SERIAL=$(printf '%s\n' "$USB_STRINGS" | sed -n 3p)
[ -n "$PRODUCT" ] || PRODUCT="unknown"
[ -n "$MANUFACTURER" ] || MANUFACTURER="unknown"
[ -n "$SERIAL" ] || SERIAL="unknown"

MIC=$(mic_label "$VENDOR_ID" "$PRODUCT" "$MANUFACTURER")

# Pull the calibration gain out of the product string if it is there.
GAIN=$(printf '%s' "$PRODUCT" | sed -n 's/.*[Gg]ain:*[[:space:]]*\([0-9.]*\)[[:space:]]*dB.*/\1/p')
[ -n "$GAIN" ] || GAIN="unknown"

applog "found ${MIC} - ${USBID} on ALSA card ${CARD} (\"${PRODUCT}\", gain ${GAIN} dB)"

# --- pick a working sample format -----------------------------------------

# hw: devices do no conversion, so every parameter must match the hardware
# exactly - and UMIK-1s commonly enumerate as a 2-channel device even though
# the mic is mono. Probe channel counts as well as formats, and keep the last
# arecord error: "Channels count non available" vs "Permission denied" name
# completely different bugs, and without this the journal is blind.
#
# The order comes from mic_prefs: rate outermost, then channel count, then
# format. So at the mic's best rate we try mono before stereo before falling
# to the next rate down - a mono recording at 192k beats a stereo one at 48k
# for a measurement mic, and it is half the bytes either way. First
# combination the hardware accepts wins.
DEV="hw:${CARD},0"
PREFS=$(mic_prefs "$VENDOR_ID")
# Env overrides win, and both now take a list - a bare "UMIK_RATE=96000" is
# just a one-element list, so the old single-value usage keeps working.
PROBE_FORMATS=$(printf '%s' "${UMIK_FORMAT:-$(printf '%s\n' "$PREFS" | sed -n 1p)}" | tr ',' ' ')
PROBE_RATES=$(printf '%s' "${UMIK_RATE:-$(printf '%s\n' "$PREFS" | sed -n 2p)}" | tr ',' ' ')
# Snapshot the wanted channel count: the loop below reassigns CHANNELS on
# success, and the FATAL line must still report what we asked for.
WANT_CHANNELS=$CHANNELS

applog "capture preference for ${MIC}: formats ${PROBE_FORMATS}, rates ${PROBE_RATES}"
applog "probing ${DEV}: rates ${PROBE_RATES} x ${WANT_CHANNELS}/2/1 ch x formats ${PROBE_FORMATS}"
FORMAT=""
RATE=""
PROBE_ERR=""
PROBE_ERRS=""
for r in $PROBE_RATES; do
    for c in $WANT_CHANNELS 2 1; do
        for f in $PROBE_FORMATS; do
            if PROBE_ERR=$(arecord -D "$DEV" -f "$f" -r "$r" -c "$c" \
                           -d 1 -t raw 2>&1 >/dev/null </dev/null); then
                FORMAT="$f"
                RATE="$r"
                CHANNELS="$c"
                break 3
            fi
            # Keep every combo's error, not just the last: which combos
            # failed with WHICH error is the whole diagnosis (busy vs
            # no-such-device vs bad format are entirely different problems).
            PROBE_ERRS="${PROBE_ERRS}[${f}/${c}ch/${r}Hz] $(printf '%s' "$PROBE_ERR" | tr '\n' ' ' | cut -c1-120)  "
        done
    done
done
if [ -z "$FORMAT" ]; then
    applog "FATAL: no working capture settings (tried formats ${PROBE_FORMATS} x ${WANT_CHANNELS}/2/1 ch x rates ${PROBE_RATES} Hz)"
    applog "probe errors: $(printf '%s' "$PROBE_ERRS" | cut -c1-700)"
    case "$PROBE_ERRS" in *usy*)
        applog "hint: 'busy' means something else holds the mic (leftover arecord? two recorder instances?)" ;;
    esac
    exit 1
fi
# What this mic actually costs in disk, at the moment the format and rate are
# settled. Both are negotiated, so a swap-in mic can change the burn by an
# order of magnitude without anyone noticing: 48k/24-bit mono is 518 MB/hour,
# 192k/32-bit float mono is 2.8 GB/hour, and stereo doubles either. Put the
# number in the card's own log so the answer travels with the recordings.
case "$FORMAT" in
    S16_LE|S16_BE|U16_LE|U16_BE)                   SAMPLE_BYTES=2 ;;
    S24_3LE|S24_3BE|U24_3LE|U24_3BE)               SAMPLE_BYTES=3 ;;
    S32_LE|S32_BE|U32_LE|U32_BE|S24_LE|S24_BE|FLOAT_LE|FLOAT_BE) SAMPLE_BYTES=4 ;;
    S8|U8)                                         SAMPLE_BYTES=1 ;;
    *)                                             SAMPLE_BYTES=0 ;;  # unknown
esac
BYTES_PER_SEC=$((SAMPLE_BYTES * CHANNELS * RATE))
# Decimal MB, matching how the README quotes the storage budget and how df
# on a disk you can actually buy quotes its capacity.
MB_PER_HOUR=$((BYTES_PER_SEC * 3600 / 1000000))
applog "capture format ${FORMAT} @ ${RATE} Hz, ${CHANNELS} ch, ${SEGMENT}s segments (${BYTES_PER_SEC} B/s, ~${MB_PER_HOUR} MB/hour)"

# A WAV data chunk is a 32-bit byte count, so a segment cannot exceed 4 GiB
# and arecord stops the file at 2 GiB. At the shipped 600s that is not close
# (192k float stereo = 922MB), but UMIK_SEGMENT_SECONDS is a knob and the
# rate is now negotiated, so the two can now multiply into a truncated
# segment where before they could not. Warn rather than refuse: a short
# recording is still a recording, and the rotation is what caps it.
SEG_MB=$((BYTES_PER_SEC * SEGMENT / 1000000))
if [ "$BYTES_PER_SEC" -gt 0 ] && [ "$((BYTES_PER_SEC * SEGMENT))" -gt 2147483647 ]; then
    applog "WARNING: a ${SEGMENT}s segment at this format is ~${SEG_MB}MB - over WAV's 2GiB limit; arecord will cut it short. Lower UMIK_SEGMENT_SECONDS."
fi

# --- free space guard -------------------------------------------------------
# A 128GB card holds ~10 days of 48k/24-bit mono. When it fills, stop
# cleanly instead of letting arecord fail and systemd thrash-restart us.
# Exit code 78 tells the unit (RestartPreventExitStatus=78) not to restart.

MIN_FREE_MB=${UMIK_MIN_FREE_MB:-512}
free_mb() { df -Pm "$1" | awk 'NR==2 {print $4}'; }

mkdir -p "$DATA_DIR"
if [ "$(free_mb "$DATA_DIR")" -lt "$MIN_FREE_MB" ]; then
    applog "FATAL: less than ${MIN_FREE_MB}MB free - storage is full; stopping cleanly"
    log "move old sessions off ${DATA_DIR} and power-cycle to resume"
    exit 78
fi

# --- unit identity ----------------------------------------------------------
# Which physical recorder is this? Named by 03-inject.sh --unit (umik1,
# umik2, ...) in a file at the top of the boot partition. With two units in
# the field, every session must carry its origin - the name prefixes the
# session directory and is recorded in session.json, so the archive and any
# uploads can never conflate the units, even when sticks move between Pis.
# Fallback: the CPU serial, unique per Pi, so an unnamed unit still cannot
# collide with a named one.
UNIT=$(tr -cd 'a-z0-9-' < /boot/firmware/umik-unit 2>/dev/null | cut -c1-16)
if [ -z "$UNIT" ]; then
    UNIT="pi-$(awk '/^Serial/ {s=$3} END {print substr(s, length(s)-3)}' /proc/cpuinfo 2>/dev/null)"
    [ "$UNIT" = "pi-" ] && UNIT=pi-unknown
fi

# --- session directory ------------------------------------------------------

SEQ_FILE="${DATA_DIR}/.session-counter"
SEQ=$(cat "$SEQ_FILE" 2>/dev/null || echo 0)
case "$SEQ" in ''|*[!0-9]*) SEQ=0 ;; esac

# No NTP on this box, so the wall clock is trustworthy ONLY on GPS-anchored
# evidence: umik-gps-time set it from GPS this boot, or umik-rtc-time
# restored it from the battery-backed DS3231 that a GPS fix disciplined on
# an earlier boot. Plausibility heuristics ("looks recent, and ahead of the
# previous session") were tried and field-defeated: the image's own build
# epoch is recent enough to pass any fixed threshold, and since every boot
# restarts at that same epoch, the counter-mtime tiebreak degenerated into
# a coin flip - one session shipped clock_trusted=true off a fake clock.
# GPS-anchored or nothing.
TRUSTED=false

# umik-gps-time.service runs before us; if a USB GPS module got usable time
# this boot it has already stepped the clock and left the details in
# /run/umik-gps.json. /run is tmpfs, so the file cannot be a stale survivor
# of an earlier boot: "synced": true means THIS boot's clock is GPS time.
GPS_JSON=$(cat /run/umik-gps.json 2>/dev/null || true)
TIME_SOURCE=none
case "$GPS_JSON" in
    *'"synced": true'*)
        TRUSTED=true
        # "gps" = time from a position fix; "gps-time-only" = time accepted
        # without one (indoors: single-satellite decode or the module's
        # battery-backed RTC) - equally usable, just honest about the path.
        TIME_SOURCE=gps
        case "$GPS_JSON" in *'"fix": true'*) ;; *) TIME_SOURCE=gps-time-only ;; esac
        ;;
esac

# Same trust grade, different wire: umik-net-time fetched NTP over a
# one-time ethernet cable this boot (and disciplined the RTC while it was
# at it). Real UTC from an authoritative source, so clock_trusted.
NET_JSON=$(cat /run/umik-net.json 2>/dev/null || true)
if [ "$TRUSTED" = false ]; then
    case "$NET_JSON" in *'"synced": true'*)
        TRUSTED=true
        TIME_SOURCE=ntp
        ;;
    esac
fi

# Next in the hierarchy: the battery-backed DS3231 that umik-gps-time or
# umik-net-time disciplined on some earlier boot. umik-rtc-time applied it
# before we started; a valid reading is GPS/NTP time within crystal drift
# (~1 min/year), so it keeps clock_trusted - this is what lets the GPS
# module or ethernet cable be unplugged once it has ever synced.
RTC_JSON=$(cat /run/umik-rtc.json 2>/dev/null || true)
if [ "$TRUSTED" = false ]; then
    case "$RTC_JSON" in *'"trusted": true'*)
        TRUSTED=true
        TIME_SOURCE=rtc
        ;;
    esac
fi

# Below GPS in the hierarchy: a Mac-written time-seed applied at boot
# (umik-time-seed.service). It makes the clock approximately right - real
# time is AT LEAST the seed - so session names carry real dates, but it is
# a floor, not a sync: TRUSTED stays false.
SEED_JSON=$(cat /run/umik-time-seed.json 2>/dev/null || true)
if [ "$TIME_SOURCE" = none ]; then
    case "$SEED_JSON" in *'"applied": true'*) TIME_SOURCE=seeded ;; esac
fi

SEQ=$((SEQ + 1))
# Write-then-rename: a power cut mid-write must not zero the counter.
printf '%s\n' "$SEQ" > "${SEQ_FILE}.tmp"
mv -f "${SEQ_FILE}.tmp" "$SEQ_FILE"
sync

WALL=$(date -u +%Y%m%dT%H%M%SZ)

SESSION=$(printf '%06d' "$SEQ")
SESSION_DIR="${DATA_DIR}/${UNIT}_${SESSION}_${WALL}"
mkdir -p "$SESSION_DIR"

cat > "${SESSION_DIR}/session.json" <<EOF
{
  "session": "${SESSION}",
  "unit": "${UNIT}",
  "started_utc": "${WALL}",
  "clock_trusted": ${TRUSTED},
  "time_source": "${TIME_SOURCE}",
  "gps": ${GPS_JSON:-null},
  "net": ${NET_JSON:-null},
  "rtc": ${RTC_JSON:-null},
  "time_seed": ${SEED_JSON:-null},
  "storage": "${STORAGE}",
  "device": {
    "usb_id": "${USBID}",
    "vendor_id": "${VENDOR_ID}",
    "product_id": "${PRODUCT_ID}",
    "mic": "${MIC}",
    "product": "${PRODUCT}",
    "manufacturer": "${MANUFACTURER}",
    "serial": "${SERIAL}",
    "calibration_gain_db": "${GAIN}",
    "alsa_card": ${CARD}
  },
  "format": {
    "encoding": "${FORMAT}",
    "sample_rate": ${RATE},
    "channels": ${CHANNELS}
  },
  "segment_seconds": ${SEGMENT}
}
EOF
sync

[ "$TRUSTED" = true ] || \
    log "WARNING: clock not anchored (no GPS/NTP sync this boot, no disciplined RTC);"
[ "$TRUSTED" = true ] || \
    log "         rely on the session counter (${SESSION}) for ordering"

applog "session ${SESSION} started -> ${SESSION_DIR} (clock_trusted=${TRUSTED}, time_source=${TIME_SOURCE}, $(free_mb "$DATA_DIR")MB free)"

# --- capture ----------------------------------------------------------------
# arecord closes the current file cleanly on SIGINT, so translate the
# systemd SIGTERM into SIGINT and wait for it to finish before syncing.

# Full date in the segment name: with %H%M%S alone the names would repeat
# after 24 hours and arecord would overwrite day-old segments in place.
arecord -D "$DEV" \
        -f "$FORMAT" -r "$RATE" -c "$CHANNELS" \
        --use-strftime --max-file-time "$SEGMENT" \
        "${SESSION_DIR}/seg-%Y%m%d-%H%M%S.wav" &
APID=$!

# --- heartbeat: prove we are actually writing -------------------------------
# Every UMIK_LOG_INTERVAL (default 60s), log the segment being written and
# its growing size. A healthy box produces a visibly advancing byte count;
# a stuck one stops the heartbeat - either way the log tells you.
MON_INTERVAL=${UMIK_LOG_INTERVAL:-60}
(
    while sleep "$MON_INTERVAL"; do
        kill -0 "$APID" 2>/dev/null || break
        seg=$(ls -t "$SESSION_DIR"/seg-*.wav 2>/dev/null | head -1)
        [ -n "$seg" ] || { applog "WARNING: no segment file yet"; continue; }
        segbytes=$(wc -c < "$seg" 2>/dev/null) || segbytes=0
        segkb=$(( ${segbytes:-0} / 1024 ))
        nseg=$(ls "$SESSION_DIR"/seg-*.wav 2>/dev/null | wc -l | tr -d ' ')
        totmb=$(du -sm "$SESSION_DIR" 2>/dev/null | cut -f1)
        applog "writing ${seg##*/} (${segkb}KB) - segment ${nseg}, session ${totmb}MB, $(free_mb "$DATA_DIR")MB free"
    done
) &
MPID=$!

shutdown() {
    applog "stopping - closing current segment"
    kill "$MPID" 2>/dev/null || true
    kill -INT "$APID" 2>/dev/null || true
    wait "$APID" 2>/dev/null || true
    sync
    applog "session ${SESSION} stopped cleanly ($(du -sm "$SESSION_DIR" 2>/dev/null | cut -f1)MB total)"
    exit 0
}
trap shutdown TERM INT

wait "$APID" || true
kill "$MPID" 2>/dev/null || true
applog "WARNING: arecord exited on its own (mic unplugged?) - systemd will restart"
exit 1
