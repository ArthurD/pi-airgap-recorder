#!/bin/sh
# umik-record - continuous segmented capture from a miniDSP UMIK-1.
#
# Design notes:
#   * The UMIK-1's USB product string embeds its per-unit calibration gain
#     (e.g. "Umik-1  Gain:18dB"), so the ALSA card *name* differs between
#     units. We therefore resolve the card by USB VID:PID, never by name.
#   * Recording is segmented so that an unannounced power cut can damage at
#     most the in-flight segment. Every completed segment is closed and
#     synced by arecord on rotation.
#   * The Pi 4B has no built-in RTC and no network, so sessions are ordered
#     by a persistent counter on the data partition. Wall time is recorded
#     but marked trusted only on GPS-anchored evidence: a GPS sync this
#     boot, or a DS3231 RTC that GPS disciplined on an earlier boot.

set -eu

# The UMIK-1 exists in at least two hardware revisions - an older mini-USB one
# and a newer USB-C one - and they do not necessarily share a product ID. So we
# match on the miniDSP *vendor* ID and take any audio device it presents.
# Set UMIK_PID to narrow it if you ever attach more than one miniDSP device.
#
# Nothing below this line is miniDSP-specific: the format probe asks the
# hardware what it accepts, and the calibration gain simply reads "unknown"
# when the product string has none. So the vendor is a knob, not a premise:
#   UMIK_VID=<vvvv>  record from a different USB vendor's device
#   UMIK_VID=any     record from the first USB audio capture device found
UMIK_VID=${UMIK_VID:-2752}
UMIK_PID=${UMIK_PID:-}

# Storage: a USB drive mounted at /data/usb by umik-usb-detect wins, so
# recordings can be pulled, copied anywhere, and the stick put back. No
# stick -> the SD card. UMIK_DATA_DIR overrides both.
DATA_DIR=${UMIK_DATA_DIR:-}
if [ -z "$DATA_DIR" ]; then
    if mountpoint -q /data/usb 2>/dev/null; then
        DATA_DIR=/data/usb/recordings
        STORAGE=usb
    else
        DATA_DIR=/data/recordings
        STORAGE=sd
    fi
else
    STORAGE=custom
fi

# --- persistent activity log ------------------------------------------------
# journald is volatile (RAM) on this box, so mirror the interesting events to
# a plain text file on the SAME medium as the recordings - whatever you pull
# and read on a Mac carries its own log. Rotates at ~5MB, keeps one previous.

LOGDIR="$(dirname "$DATA_DIR")/logs"
LOGFILE="${LOGDIR}/umik.log"
BOOTID=$(cut -c1-8 /proc/sys/kernel/random/boot_id 2>/dev/null || echo unknown)

# log() MUST be defined before applog's first call: under set -e an undefined
# function is a fatal 127, killing the service before it logs anything.
log() { echo "umik-record: $*" >&2; }

applog() {
    log "$*"
    mkdir -p "$LOGDIR" 2>/dev/null || return 0
    [ -w "$LOGDIR" ] || return 0
    # "|| true" matters: under set -e a failed rotation mv would otherwise
    # kill the whole recorder from inside its own logging function.
    if [ -f "$LOGFILE" ] && [ "$(wc -c < "$LOGFILE")" -gt 5242880 ]; then
        mv -f "$LOGFILE" "${LOGFILE}.1" 2>/dev/null || true
    fi
    printf '%s boot=%s up=%3ss %s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$BOOTID" \
        "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo '?')" "$*" \
        >> "$LOGFILE" 2>/dev/null || true
}

# A restart-loop with no FATAL line was observed in the field once: the shell
# died between two applog calls and left no trace. Whatever the cause, an
# abnormal exit must always leave a line in the activity log.
trap 'rc=$?; [ "$rc" -eq 0 ] || applog "ABNORMAL EXIT status=${rc}"' EXIT

applog "=== service start: storage=${STORAGE} data=${DATA_DIR} ==="
RATE=${UMIK_RATE:-48000}
CHANNELS=${UMIK_CHANNELS:-1}
SEGMENT=${UMIK_SEGMENT_SECONDS:-600}
WAIT_SECS=${UMIK_WAIT_SECONDS:-60}

# --- locate the UMIK-1 -----------------------------------------------------

# Does a "vvvv:pppp" usbid belong to the mic we want?
# UMIK_VID=any matches any USB audio device - /proc/asound only lists sound
# cards in the first place, so "any" still cannot select a keyboard.
id_matches() {
    if [ "$UMIK_VID" = "any" ]; then
        return 0
    elif [ -n "$UMIK_PID" ]; then
        [ "$1" = "${UMIK_VID}:${UMIK_PID}" ]
    else
        case "$1" in "${UMIK_VID}:"*) return 0 ;; *) return 1 ;; esac
    fi
}

# Echoes "<card-index> <usbid>".
find_card() {
    for u in /proc/asound/card*/usbid; do
        [ -r "$u" ] || continue
        _id=$(cat "$u")
        id_matches "$_id" || continue
        c=${u%/usbid}
        echo "${c##*/card} ${_id}"
        return 0
    done
    return 1
}

# Product string for the exact device that owns the card we picked. This takes
# the resolved usbid rather than re-running id_matches: /sys/bus/usb/devices
# lists every USB device, so under UMIK_VID=any a looser match here would
# happily report a hub's or keyboard's product string as the microphone's.
find_product() { # <vvvv:pppp>
    for d in /sys/bus/usb/devices/*/; do
        [ -r "${d}idVendor" ] && [ -r "${d}idProduct" ] || continue
        [ "$(cat "${d}idVendor"):$(cat "${d}idProduct")" = "$1" ] || continue
        if [ -r "${d}product" ]; then cat "${d}product"; return 0; fi
    done
    return 1
}

# udev may not have settled when we start; wait rather than fail the unit.
elapsed=0
while ! FOUND=$(find_card); do
    if [ "$elapsed" -ge "$WAIT_SECS" ]; then
        if [ "$UMIK_VID" = "any" ]; then
            applog "FATAL: no USB audio capture device after ${WAIT_SECS}s - is the mic plugged into a BLACK USB 2.0 port?"
        else
            applog "FATAL: no device from USB vendor ${UMIK_VID} after ${WAIT_SECS}s - is the mic plugged into a BLACK USB 2.0 port? (set UMIK_VID=any to accept any USB mic)"
        fi
        for u in /proc/asound/card*/usbid; do
            [ -r "$u" ] && applog "  saw sound device: $(cat "$u")"
        done
        log "(the UMIK cable is USB-C at the mic, USB-A at the Pi; the Pi's USB-C is power-only)"
        exit 1
    fi
    sleep 1
    elapsed=$((elapsed + 1))
done
CARD=${FOUND% *}
USBID=${FOUND#* }

# The product string comes from the USB device itself - untrusted input. It
# is only ever data here (heredocs substitute values without re-evaluating
# them), but strip JSON-breaking and control characters before storing it.
PRODUCT=$(find_product "$USBID" 2>/dev/null | tr -cd 'A-Za-z0-9 ._:()+-' | cut -c1-64)
[ -n "$PRODUCT" ] || PRODUCT="unknown"
# Pull the calibration gain out of the product string if it is there.
GAIN=$(printf '%s' "$PRODUCT" | sed -n 's/.*[Gg]ain:*[[:space:]]*\([0-9.]*\)[[:space:]]*dB.*/\1/p')
[ -n "$GAIN" ] || GAIN="unknown"

applog "found ${USBID} on ALSA card ${CARD} (\"${PRODUCT}\", gain ${GAIN} dB)"

# --- pick a working sample format -----------------------------------------

# hw: devices do no conversion, so every parameter must match the hardware
# exactly - and UMIK-1s commonly enumerate as a 2-channel device even though
# the mic is mono. Probe channel counts as well as formats, and keep the last
# arecord error: "Channels count non available" vs "Permission denied" name
# completely different bugs, and without this the journal is blind.
DEV="hw:${CARD},0"
applog "probing ${DEV}: formats ${UMIK_FORMAT:-S24_3LE S32_LE S16_LE} x ${CHANNELS}/2/1 ch at ${RATE} Hz"
FORMAT=""
PROBE_ERR=""
PROBE_ERRS=""
for c in $CHANNELS 2 1; do
    for f in ${UMIK_FORMAT:-S24_3LE S32_LE S16_LE}; do
        if PROBE_ERR=$(arecord -D "$DEV" -f "$f" -r "$RATE" -c "$c" \
                       -d 1 -t raw 2>&1 >/dev/null </dev/null); then
            FORMAT="$f"
            CHANNELS="$c"
            break 2
        fi
        # Keep every combo's error, not just the last: which combos failed
        # with WHICH error is the whole diagnosis (busy vs no-such-device
        # vs bad format are entirely different problems).
        PROBE_ERRS="${PROBE_ERRS}[${f}/${c}ch] $(printf '%s' "$PROBE_ERR" | tr '\n' ' ' | cut -c1-120)  "
    done
done
if [ -z "$FORMAT" ]; then
    applog "FATAL: no working format at ${RATE} Hz (tried ${UMIK_FORMAT:-S24_3LE S32_LE S16_LE} x ${CHANNELS}/2/1 ch)"
    applog "probe errors: $(printf '%s' "$PROBE_ERRS" | cut -c1-700)"
    case "$PROBE_ERRS" in *usy*)
        applog "hint: 'busy' means something else holds the mic (leftover arecord? two recorder instances?)" ;;
    esac
    exit 1
fi
applog "capture format ${FORMAT} @ ${RATE} Hz, ${CHANNELS} ch, ${SEGMENT}s segments"

# --- free space guard -------------------------------------------------------
# A 128GB card holds ~10 days of 48k/24-bit mono. When it fills, stop
# cleanly instead of letting arecord fail and systemd thrash-restart us.
# Exit code 78 tells the unit (RestartPreventExitStatus=78) not to restart.

MIN_FREE_MB=${UMIK_MIN_FREE_MB:-512}
free_mb() { df -Pm "$1" | awk 'NR==2 {print $4}'; }

mkdir -p "$DATA_DIR"
if [ "$(free_mb "$DATA_DIR")" -lt "$MIN_FREE_MB" ]; then
    applog "FATAL: less than ${MIN_FREE_MB}MB free - storage is full; stopping cleanly"
    log "move old sessions off ${DATA_DIR} and power-cycle to resume"
    exit 78
fi

# --- unit identity ----------------------------------------------------------
# Which physical recorder is this? Named by 03-inject.sh --unit (umik1,
# umik2, ...) in a file at the top of the boot partition. With two units in
# the field, every session must carry its origin - the name prefixes the
# session directory and is recorded in session.json, so the archive and any
# uploads can never conflate the units, even when sticks move between Pis.
# Fallback: the CPU serial, unique per Pi, so an unnamed unit still cannot
# collide with a named one.
UNIT=$(tr -cd 'a-z0-9-' < /boot/firmware/umik-unit 2>/dev/null | cut -c1-16)
if [ -z "$UNIT" ]; then
    UNIT="pi-$(awk '/^Serial/ {s=$3} END {print substr(s, length(s)-3)}' /proc/cpuinfo 2>/dev/null)"
    [ "$UNIT" = "pi-" ] && UNIT=pi-unknown
fi

# --- session directory ------------------------------------------------------

SEQ_FILE="${DATA_DIR}/.session-counter"
SEQ=$(cat "$SEQ_FILE" 2>/dev/null || echo 0)
case "$SEQ" in ''|*[!0-9]*) SEQ=0 ;; esac

# No NTP on this box, so the wall clock is trustworthy ONLY on GPS-anchored
# evidence: umik-gps-time set it from GPS this boot, or umik-rtc-time
# restored it from the battery-backed DS3231 that a GPS fix disciplined on
# an earlier boot. Plausibility heuristics ("looks recent, and ahead of the
# previous session") were tried and field-defeated: the image's own build
# epoch is recent enough to pass any fixed threshold, and since every boot
# restarts at that same epoch, the counter-mtime tiebreak degenerated into
# a coin flip - one session shipped clock_trusted=true off a fake clock.
# GPS-anchored or nothing.
TRUSTED=false

# umik-gps-time.service runs before us; if a USB GPS module got usable time
# this boot it has already stepped the clock and left the details in
# /run/umik-gps.json. /run is tmpfs, so the file cannot be a stale survivor
# of an earlier boot: "synced": true means THIS boot's clock is GPS time.
GPS_JSON=$(cat /run/umik-gps.json 2>/dev/null || true)
TIME_SOURCE=none
case "$GPS_JSON" in
    *'"synced": true'*)
        TRUSTED=true
        # "gps" = time from a position fix; "gps-time-only" = time accepted
        # without one (indoors: single-satellite decode or the module's
        # battery-backed RTC) - equally usable, just honest about the path.
        TIME_SOURCE=gps
        case "$GPS_JSON" in *'"fix": true'*) ;; *) TIME_SOURCE=gps-time-only ;; esac
        ;;
esac

# Same trust grade, different wire: umik-net-time fetched NTP over a
# one-time ethernet cable this boot (and disciplined the RTC while it was
# at it). Real UTC from an authoritative source, so clock_trusted.
NET_JSON=$(cat /run/umik-net.json 2>/dev/null || true)
if [ "$TRUSTED" = false ]; then
    case "$NET_JSON" in *'"synced": true'*)
        TRUSTED=true
        TIME_SOURCE=ntp
        ;;
    esac
fi

# Next in the hierarchy: the battery-backed DS3231 that umik-gps-time or
# umik-net-time disciplined on some earlier boot. umik-rtc-time applied it
# before we started; a valid reading is GPS/NTP time within crystal drift
# (~1 min/year), so it keeps clock_trusted - this is what lets the GPS
# module or ethernet cable be unplugged once it has ever synced.
RTC_JSON=$(cat /run/umik-rtc.json 2>/dev/null || true)
if [ "$TRUSTED" = false ]; then
    case "$RTC_JSON" in *'"trusted": true'*)
        TRUSTED=true
        TIME_SOURCE=rtc
        ;;
    esac
fi

# Below GPS in the hierarchy: a Mac-written time-seed applied at boot
# (umik-time-seed.service). It makes the clock approximately right - real
# time is AT LEAST the seed - so session names carry real dates, but it is
# a floor, not a sync: TRUSTED stays false.
SEED_JSON=$(cat /run/umik-time-seed.json 2>/dev/null || true)
if [ "$TIME_SOURCE" = none ]; then
    case "$SEED_JSON" in *'"applied": true'*) TIME_SOURCE=seeded ;; esac
fi

SEQ=$((SEQ + 1))
# Write-then-rename: a power cut mid-write must not zero the counter.
printf '%s\n' "$SEQ" > "${SEQ_FILE}.tmp"
mv -f "${SEQ_FILE}.tmp" "$SEQ_FILE"
sync

WALL=$(date -u +%Y%m%dT%H%M%SZ)

SESSION=$(printf '%06d' "$SEQ")
SESSION_DIR="${DATA_DIR}/${UNIT}_${SESSION}_${WALL}"
mkdir -p "$SESSION_DIR"

cat > "${SESSION_DIR}/session.json" <<EOF
{
  "session": "${SESSION}",
  "unit": "${UNIT}",
  "started_utc": "${WALL}",
  "clock_trusted": ${TRUSTED},
  "time_source": "${TIME_SOURCE}",
  "gps": ${GPS_JSON:-null},
  "net": ${NET_JSON:-null},
  "rtc": ${RTC_JSON:-null},
  "time_seed": ${SEED_JSON:-null},
  "storage": "${STORAGE}",
  "device": {
    "usb_id": "${USBID}",
    "product": "${PRODUCT}",
    "calibration_gain_db": "${GAIN}",
    "alsa_card": ${CARD}
  },
  "format": {
    "encoding": "${FORMAT}",
    "sample_rate": ${RATE},
    "channels": ${CHANNELS}
  },
  "segment_seconds": ${SEGMENT}
}
EOF
sync

[ "$TRUSTED" = true ] || \
    log "WARNING: clock not anchored (no GPS/NTP sync this boot, no disciplined RTC);"
[ "$TRUSTED" = true ] || \
    log "         rely on the session counter (${SESSION}) for ordering"

applog "session ${SESSION} started -> ${SESSION_DIR} (clock_trusted=${TRUSTED}, time_source=${TIME_SOURCE}, $(free_mb "$DATA_DIR")MB free)"

# --- capture ----------------------------------------------------------------
# arecord closes the current file cleanly on SIGINT, so translate the
# systemd SIGTERM into SIGINT and wait for it to finish before syncing.

# Full date in the segment name: with %H%M%S alone the names would repeat
# after 24 hours and arecord would overwrite day-old segments in place.
arecord -D "$DEV" \
        -f "$FORMAT" -r "$RATE" -c "$CHANNELS" \
        --use-strftime --max-file-time "$SEGMENT" \
        "${SESSION_DIR}/seg-%Y%m%d-%H%M%S.wav" &
APID=$!

# --- heartbeat: prove we are actually writing -------------------------------
# Every UMIK_LOG_INTERVAL (default 60s), log the segment being written and
# its growing size. A healthy box produces a visibly advancing byte count;
# a stuck one stops the heartbeat - either way the log tells you.
MON_INTERVAL=${UMIK_LOG_INTERVAL:-60}
(
    while sleep "$MON_INTERVAL"; do
        kill -0 "$APID" 2>/dev/null || break
        seg=$(ls -t "$SESSION_DIR"/seg-*.wav 2>/dev/null | head -1)
        [ -n "$seg" ] || { applog "WARNING: no segment file yet"; continue; }
        segbytes=$(wc -c < "$seg" 2>/dev/null) || segbytes=0
        segkb=$(( ${segbytes:-0} / 1024 ))
        nseg=$(ls "$SESSION_DIR"/seg-*.wav 2>/dev/null | wc -l | tr -d ' ')
        totmb=$(du -sm "$SESSION_DIR" 2>/dev/null | cut -f1)
        applog "writing ${seg##*/} (${segkb}KB) - segment ${nseg}, session ${totmb}MB, $(free_mb "$DATA_DIR")MB free"
    done
) &
MPID=$!

shutdown() {
    applog "stopping - closing current segment"
    kill "$MPID" 2>/dev/null || true
    kill -INT "$APID" 2>/dev/null || true
    wait "$APID" 2>/dev/null || true
    sync
    applog "session ${SESSION} stopped cleanly ($(du -sm "$SESSION_DIR" 2>/dev/null | cut -f1)MB total)"
    exit 0
}
trap shutdown TERM INT

wait "$APID" || true
kill "$MPID" 2>/dev/null || true
applog "WARNING: arecord exited on its own (mic unplugged?) - systemd will restart"
exit 1
