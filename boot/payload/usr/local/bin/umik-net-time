#!/bin/sh
# umik-net-time - one-time trusted clock sync over a WIRED ethernet cable.
#
# Design notes:
#   * WHY THIS EXISTS. The original "find initial time" story was GPS: boot
#     once outdoors, get a fix, discipline the DS3231 RTC, unplug the module
#     forever. The first field attempt got the fix but the RTC write failed
#     silently (see umik-gps-time), and outdoor boots are logistics. A wired
#     ethernet cable is the pivot: plug the box into a router for ONE boot,
#     this service fetches NTP time, disciplines the RTC, then tears the
#     network back down. Every later boot gets trusted time from the RTC
#     with nothing attached.
#   * RADIO SILENCE HOLDS. Ethernet is copper - nothing here powers a radio,
#     and umik-radio-check still asserts no wireless hardware exists. What
#     changes is the air-gap: for the seconds between carrier-up and
#     teardown this box is on a network. That window exists only when a
#     human has physically plugged a cable in; with no cable this service
#     is a ~2s no-op and the box never touches a network, same as before.
#   * NO CABLE = NO-OP. Like the GPS module, a network is an optional,
#     never-blocking time source: no interface, no carrier, no DHCP, no
#     NTP - each is a logged no-op and recording starts exactly as before.
#     Every path exits 0 and tears the link back down.
#   * STOCK TOOLS ONLY, like everything else on this box: ip(8) for the
#     link, systemd-networkd for DHCP (part of the image; disabled in
#     steady state, started only inside this window), systemd-timesyncd
#     for NTP (present but masked at provision; unmasked for the window
#     and re-masked after). Fallback DHCP clients are tried if networkd
#     is ever missing. Anything absent is logged loudly, not fatal.
#   * THE RTC WRITE IS THE WHOLE POINT. An NTP sync is the same trust
#     grade this project gives a GPS fix (real UTC from an authoritative
#     source), so it disciplines the RTC the same way. Two writers exist
#     now: umik-gps-time (position fix) and this script (NTP sync); both
#     capture hwclock's error text instead of discarding it - a silent
#     RTC failure already cost one field cycle. systemd-timesyncd also
#     writes the RTC itself on every successful sync, so the chip gets
#     two chances per window.
#   * Everything umik-record needs lands in /run/umik-net.json. /run is
#     tmpfs, so a stale file from a previous boot cannot claim the clock
#     is synced.

set -u

IFACE=${UMIK_NET_IFACE:-eth0}
CARRIER_WAIT=${UMIK_NET_CARRIER_WAIT:-10}
DHCP_WAIT=${UMIK_NET_DHCP_WAIT:-40}
NTP_WAIT=${UMIK_NET_NTP_WAIT:-120}
NTS_SERVER=${UMIK_NET_NTS_SERVER:-time.cloudflare.com}
NTP_SERVER=${UMIK_NET_NTP_SERVER:-time.google.com}
TLS_HOST=${UMIK_NET_TLS_HOST:-https://www.google.com/}
TLS_TOLERANCE=${UMIK_NET_TLS_TOLERANCE:-10}
STATE=/run/umik-net.json
SYNCFILE=/run/systemd/timesync/synchronized
RESOLV_BACKUP=/run/umik-resolv.conf.orig

log() { echo "umik-net-time: $*" >&2; }

applog() {
    log "$*"
    mkdir -p /data/logs 2>/dev/null || return 0
    printf '%s up=%3ss umik-net-time: %s\n' \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
        "$(cut -d. -f1 /proc/uptime 2>/dev/null || echo '?')" "$*" \
        >> /data/logs/umik.log 2>/dev/null || true
}

NET_UTC_J=null
DELTA=null
IPADDR=""
RTC_DISCIPLINED=false
TLS_STATUS=unchecked
STARTED_NETWORKD=0
STARTED_TIMESYNCD=0
DHCP_PID=""

write_state() {  # $1 = true|false, $2 = human-readable note
    cat > "${STATE}.tmp" <<EOF
{
    "synced": $1,
    "note": "$2",
    "interface": "${IFACE}",
    "ip": "${IPADDR:-none}",
    "utc": ${NET_UTC_J},
    "clock_adjustment_seconds": ${DELTA},
    "tls_check": "${TLS_STATUS}",
    "rtc_disciplined": ${RTC_DISCIPLINED}
}
EOF
    chmod 0644 "${STATE}.tmp" 2>/dev/null
    mv -f "${STATE}.tmp" "$STATE" 2>/dev/null || true
}

# --- inbound lockdown --------------------------------------------------------
# "Outbound only" made literal: a drop-all input policy for the window, so
# the box originates DHCP and NTP but answers NOTHING - no ping replies, no
# TCP resets, no ICMP port-unreachables; a scan sees a black hole. (There
# is nothing to reach anyway - sshd is purged from disk, no TCP service
# listens - this removes even the kernel's polite refusals.) Replies to our
# own queries return via conntrack; the initial DHCP exchange rides an
# AF_PACKET socket, which netfilter's input hook does not gate, and lease
# renewals are established UDP. ARP remains - the price of speaking IP at
# all. nft missing is logged, not fatal: the sysctls (no IPv6, no ping
# replies) and the empty listener set still hold.

fw_up() {
    command -v nft >/dev/null 2>&1 || {
        applog "NOTE: nft not on this image - window relies on sysctls + empty listener set"
        return 0
    }
    nft -f - <<'EOF' 2>/dev/null && applog "inbound firewall up: drop-all (outbound replies only)"
table inet umik_net_window {
    chain input {
        type filter hook input priority 0; policy drop;
        iifname "lo" accept
        ct state established,related accept
        udp sport 67 udp dport 68 accept
    }
}
EOF
}

fw_down() {
    command -v nft >/dev/null 2>&1 || return 0
    nft delete table inet umik_net_window 2>/dev/null
}

# Tear the network window back down to the box's steady state: no DHCP
# client, no networkd, timesyncd stopped and re-masked, link down, firewall
# table removed, original resolv.conf back. Called on every exit path that
# got past carrier-up, and on TERM/INT so even a killed script (systemd
# timeout) cannot leave the window open.
TORN_DOWN=0
net_down() {
    [ "$TORN_DOWN" -eq 1 ] && return 0
    TORN_DOWN=1
    [ "$STARTED_TIMESYNCD" -eq 1 ] && {
        systemctl stop systemd-timesyncd 2>/dev/null
        systemctl mask systemd-timesyncd 2>/dev/null
    }
    [ -n "$DHCP_PID" ] && kill "$DHCP_PID" 2>/dev/null
    [ "$STARTED_NETWORKD" -eq 1 ] && systemctl stop systemd-networkd systemd-networkd.socket 2>/dev/null
    ip -4 addr flush dev "$IFACE" 2>/dev/null
    ip link set "$IFACE" down 2>/dev/null
    fw_down
    if [ -f "$RESOLV_BACKUP" ]; then
        cat "$RESOLV_BACKUP" > /etc/resolv.conf 2>/dev/null
        rm -f "$RESOLV_BACKUP"
    fi
    applog "network window closed - link down, firewall removed, DHCP/NTP services stopped"
}

trap 'net_down; exit 0' TERM INT

# --- is there even a wired interface with a cable in it? --------------------

if [ ! -d "/sys/class/net/${IFACE}" ]; then
    log "no ${IFACE} on this box - skipping network time"
    write_state false "no ${IFACE} interface"
    exit 0
fi

# Lockdown BEFORE the link ever comes up: from the first electrical instant
# this box is reachable, inbound is already a black hole.
fw_up

ip link set "$IFACE" up 2>/dev/null

elapsed=0
CARRIER=0
while [ "$elapsed" -lt "$CARRIER_WAIT" ]; do
    [ "$(cat "/sys/class/net/${IFACE}/carrier" 2>/dev/null)" = "1" ] && { CARRIER=1; break; }
    sleep 1
    elapsed=$((elapsed + 1))
done

if [ "$CARRIER" -eq 0 ]; then
    # The everyday case: no cable attached. Quiet no-op, link back down.
    ip link set "$IFACE" down 2>/dev/null
    fw_down
    log "no ethernet carrier after ${CARRIER_WAIT}s - no cable; clock left as-is"
    write_state false "no ethernet cable attached"
    exit 0
fi

applog "ethernet carrier on ${IFACE} - opening a one-time network window for NTP"

# --- DHCP --------------------------------------------------------------------
# Preferred: systemd-networkd (ships with the image, left disabled; the
# .network file for ${IFACE} is installed at provision). Fallbacks cover a
# future image that drops networkd.

if [ -x /usr/lib/systemd/systemd-networkd ] || [ -x /lib/systemd/systemd-networkd ]; then
    if systemctl start systemd-networkd 2>/dev/null; then
        STARTED_NETWORKD=1
    else
        applog "WARNING: systemd-networkd failed to start"
    fi
fi
if [ "$STARTED_NETWORKD" -eq 0 ]; then
    if command -v dhclient >/dev/null 2>&1; then
        dhclient -nw "$IFACE" 2>/dev/null && applog "fallback DHCP: dhclient on ${IFACE}"
    elif command -v dhcpcd >/dev/null 2>&1; then
        dhcpcd -b "$IFACE" 2>/dev/null && applog "fallback DHCP: dhcpcd on ${IFACE}"
    elif command -v udhcpc >/dev/null 2>&1; then
        udhcpc -b -i "$IFACE" >/dev/null 2>&1 &
        DHCP_PID=$!
        applog "fallback DHCP: udhcpc on ${IFACE}"
    else
        applog "WARNING: no DHCP client on this image (no networkd/dhclient/dhcpcd/udhcpc) - cannot fetch time"
        net_down
        write_state false "carrier present but no DHCP client available"
        exit 0
    fi
fi

elapsed=0
while [ "$elapsed" -lt "$DHCP_WAIT" ]; do
    IPADDR=$(ip -4 -o addr show dev "$IFACE" scope global 2>/dev/null | awk '{print $4; exit}')
    [ -n "$IPADDR" ] && ip -4 route list default 2>/dev/null | grep -q default && break
    sleep 1
    elapsed=$((elapsed + 1))
done

if [ -z "$IPADDR" ]; then
    applog "no DHCP lease on ${IFACE} after ${DHCP_WAIT}s - cannot fetch time; closing the window"
    net_down
    write_state false "carrier present but DHCP got no lease in ${DHCP_WAIT}s"
    exit 0
fi
applog "DHCP lease: ${IPADDR} on ${IFACE} (took ${elapsed}s)"

# --- DNS ---------------------------------------------------------------------
# timesyncd resolves its NTP server name (time.google.com, hardcoded in
# timesyncd.conf.d at provision) through /etc/resolv.conf, which nothing
# maintains on this box (NetworkManager is purged). Point it at the
# DHCP-provided DNS (networkd records it in its lease file), else the
# gateway; the original file is restored at teardown.

if ! grep -q '^nameserver' /etc/resolv.conf 2>/dev/null; then
    DNS=$(grep -rh '^DNS=' /run/systemd/netif/leases/ 2>/dev/null | head -1 | cut -d= -f2 | awk '{print $1}')
    [ -n "$DNS" ] || DNS=$(ip -4 route list default 2>/dev/null | awk '{print $3; exit}')
    if [ -n "$DNS" ]; then
        [ -f /etc/resolv.conf ] && cp /etc/resolv.conf "$RESOLV_BACKUP" 2>/dev/null
        printf 'nameserver %s\n' "$DNS" > /etc/resolv.conf 2>/dev/null \
            && applog "resolv.conf pointed at ${DNS} for the window" \
            || applog "WARNING: could not write /etc/resolv.conf - NTP by hostname may fail"
    fi
fi

# --- fetching time: NTS via chrony first, everything else is a fallback ------
# The answer we are about to mint into the RTC should be AUTHENTICATED, not
# just plausible. Real authentication is NTS (RFC 8915), which needs chrony
# - not on the stock image, and provisioning is offline by design. But this
# window is the one moment the box HAS a network, so the first cable boot
# installs chrony right through it (apt-verified signed packages; the
# seed-floored clock is close enough for TLS and Valid-Until checks), then
# syncs against time.cloudflare.com with NTS. chrony is only ever run
# one-shot (`chronyd -q`) inside the window; its daemon is disabled and
# masked the moment it lands. NOTE: installing chrony removes
# systemd-timesyncd (they conflict as time-daemon providers) - fine, chrony
# is strictly the better client and handles the plain-NTP fallback too.
#
# The fallback ladder, each rung logged:
#   1. chrony + NTS against time.cloudflare.com  - authenticated, done.
#   2. chrony plain NTP against time.google.com  - unauthenticated, so the
#      result must pass the TLS Date cross-check below.
#   3. systemd-timesyncd (only if chrony never installed; NTP= is pinned to
#      time.google.com in timesyncd.conf.d) - same cross-check required.
#
# The TLS cross-check is a poor man's NTS: fetch one HTTPS response from a
# WebPKI-validated host and compare its Date header (1s granularity) to the
# clock NTP just set. Precision comes from NTP, authentication from TLS. A
# disagreement beyond tolerance, or a failed certificate validation (the
# MITM signature), REJECTS the sync: trust flags stay false and the RTC is
# not written. The check being merely unavailable (no wget, no route) fails
# open with a loud log - the bench boot will tell us what the image has.

reject_sync() {  # $1 = note for the state file
    applog "NOTE: the system clock was already stepped by the rejected sync - this boot's timestamps are approximately right but stay UNTRUSTED"
    net_down
    write_state false "$1"
    exit 0
}

tls_cross_check() {
    if ! command -v wget >/dev/null 2>&1; then
        TLS_STATUS="unavailable(no wget)"
        applog "WARNING: wget not on this image - accepting the NTP sync UNAUTHENTICATED"
        return 0
    fi
    HDRS=$(wget -S -nv --no-hsts --max-redirect=0 --timeout=15 -O /dev/null "$TLS_HOST" 2>&1)
    WGET_RC=$?
    HTTP_DATE=$(printf '%s\n' "$HDRS" | sed -n 's/^ *[Dd]ate: *//p' | head -1)
    if [ -n "$HTTP_DATE" ]; then
        TLS_EPOCH=$(date -u -d "$HTTP_DATE" +%s 2>/dev/null)
        if [ -n "$TLS_EPOCH" ]; then
            SKEW=$(( $(date -u +%s) - TLS_EPOCH ))
            [ "$SKEW" -lt 0 ] && SKEW=$((0 - SKEW))
            if [ "$SKEW" -le "$TLS_TOLERANCE" ]; then
                TLS_STATUS="ok(skew ${SKEW}s)"
                applog "NTP answer authenticated: TLS date from ${TLS_HOST} agrees within ${SKEW}s"
                return 0
            fi
            TLS_STATUS="MISMATCH(${SKEW}s)"
            applog "CRITICAL: NTP time disagrees with the TLS-authenticated date by ${SKEW}s (tolerance ${TLS_TOLERANCE}s) - REJECTING the sync; RTC untouched"
            reject_sync "NTP rejected: disagrees with TLS-authenticated date by ${SKEW}s"
        fi
    fi
    if [ "$WGET_RC" -eq 5 ]; then
        TLS_STATUS="TLS-FAILURE"
        applog "CRITICAL: TLS certificate verification FAILED for ${TLS_HOST} - possible interception; REJECTING the sync; RTC untouched"
        reject_sync "NTP rejected: TLS certificate verification failed (possible MITM)"
    fi
    TLS_STATUS="unavailable(wget exit ${WGET_RC})"
    applog "WARNING: TLS cross-check unavailable (wget exit ${WGET_RC}) - accepting the NTP sync UNAUTHENTICATED"
    return 0
}

# What the window may need to install, one-time, apt-verified: chrony (the
# NTS client) and util-linux-extra (hwclock - Raspberry Pi OS Lite ships
# util-linux WITHOUT it since Debian split the package). The missing
# hwclock is the ACTUAL cause of the "silent" RTC failure on the GPS field
# boot: the first bench run of this window captured the error at last -
# "hwclock: not found" - after the GPS path had discarded it.
NEED=""
command -v chronyd >/dev/null 2>&1 || NEED="chrony"
command -v hwclock >/dev/null 2>&1 || NEED="${NEED} util-linux-extra"
if [ -n "$NEED" ]; then
    applog "installing through the window (one-time; apt-verified):${NEED# }"
    export DEBIAN_FRONTEND=noninteractive
    if apt-get -o Acquire::Retries=1 update >/dev/null 2>&1 \
       && apt-get -y --no-install-recommends install $NEED >/dev/null 2>&1; then
        case " $NEED " in *" chrony "*)
            # Debian auto-starts the daemon on install; this box only ever
            # runs chrony one-shot inside the window.
            systemctl disable --now chrony 2>/dev/null
            systemctl mask chrony 2>/dev/null
        ;; esac
        applog "installed: ${NEED# } (any chrony daemon disabled and masked; only this window runs it, one-shot)"
    else
        applog "WARNING: install failed (wanted:${NEED}; LAN without internet? repo unreachable?) - continuing with what the box has"
    fi
fi

SYNCED_VIA=""
BEFORE=$(date -u +%s)
UP0=$(cut -d. -f1 /proc/uptime)

if command -v chronyd >/dev/null 2>&1; then
    OUT=$(chronyd -q -t "$NTP_WAIT" "server ${NTS_SERVER} iburst nts" 2>&1)
    if [ $? -eq 0 ]; then
        SYNCED_VIA=nts
        TLS_STATUS=nts
        applog "clock SET from ${NTS_SERVER} via NTS - cryptographically authenticated time"
    else
        applog "WARNING: NTS sync with ${NTS_SERVER} failed ($(printf '%s\n' "$OUT" | tail -1)) - trying plain NTP + TLS cross-check"
        OUT=$(chronyd -q -t "$NTP_WAIT" "server ${NTP_SERVER} iburst" 2>&1)
        if [ $? -eq 0 ]; then
            SYNCED_VIA=ntp-unauthenticated
            applog "clock SET from ${NTP_SERVER} (plain NTP via chrony)"
        else
            applog "WARNING: plain NTP with ${NTP_SERVER} also failed ($(printf '%s\n' "$OUT" | tail -1))"
        fi
    fi
fi

if [ -z "$SYNCED_VIA" ] && { [ -x /usr/lib/systemd/systemd-timesyncd ] || [ -x /lib/systemd/systemd-timesyncd ]; }; then
    # systemd-timesyncd is masked in steady state (this box must not
    # quietly join networks); unmask it only inside the window.
    systemctl unmask systemd-timesyncd 2>/dev/null
    if systemctl start systemd-timesyncd 2>/dev/null; then
        STARTED_TIMESYNCD=1
        elapsed=0
        while [ "$elapsed" -lt "$NTP_WAIT" ]; do
            [ -e "$SYNCFILE" ] && break
            sleep 1
            elapsed=$((elapsed + 1))
        done
        if [ -e "$SYNCFILE" ]; then
            SYNCED_VIA=ntp-unauthenticated
            applog "clock SET from ${NTP_SERVER} (systemd-timesyncd, took ${elapsed}s)"
        fi
    else
        applog "WARNING: systemd-timesyncd failed to start"
    fi
fi

if [ -z "$SYNCED_VIA" ]; then
    applog "no time sync achieved (no reachable server, or no NTP client) - clock stays untrusted; closing the window"
    net_down
    write_state false "network up but no time sync achieved within the window"
    exit 0
fi

# An unauthenticated answer must survive the TLS cross-check before it is
# allowed anywhere near the RTC; a rejection exits inside the function.
[ "$SYNCED_VIA" = nts ] || tls_cross_check

# Synced and vetted. The seed had already floored the clock near reality,
# so the step is usually seconds - but however big it was, timestamps from
# here on are real UTC. Clock delta measured against the monotonic uptime
# counter, which no clock step can touch.
AFTER=$(date -u +%s)
UP1=$(cut -d. -f1 /proc/uptime)
DELTA=$(( (AFTER - BEFORE) - (UP1 - UP0) ))
UTC=$(date -u '+%Y-%m-%dT%H:%M:%SZ')
NET_UTC_J="\"${UTC}\""

# Keep the fallback floor fresh too.
command -v fake-hwclock >/dev/null 2>&1 && fake-hwclock save 2>/dev/null

# Discipline the battery-backed RTC - the reason this service exists. Keep
# hwclock's stderr: its one silent failure is why the GPS pivot happened.
if [ -e /sys/class/rtc/rtc0 ]; then
    if ERR=$(hwclock --systohc --utc --noadjfile 2>&1); then
        RTC_DISCIPLINED=true
        applog "RTC disciplined from ${SYNCED_VIA} time - future boots carry trusted time with no cable attached"
    else
        applog "WARNING: RTC present but hwclock --systohc failed (${ERR:-no error output}) - RTC not disciplined"
    fi
else
    applog "NOTE: no RTC fitted - network time is good for THIS boot only"
fi

applog "clock SET over ${IFACE}: ${UTC} via ${SYNCED_VIA} (moved ~${DELTA}s)"

net_down
if [ "$SYNCED_VIA" = nts ]; then
    write_state true "clock set via NTS-authenticated NTP (${NTS_SERVER})"
else
    write_state true "clock set via plain NTP, TLS cross-check: ${TLS_STATUS}"
fi
exit 0
