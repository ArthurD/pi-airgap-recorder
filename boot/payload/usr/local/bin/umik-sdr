# rtl_power's hop planner (src/rtl_power.c, identical in 2.0.2 and 2.0.3).
# power_plan() reproduces it integer for integer, so the scan grid, the
# timeouts and --fake all match what the real tool does.
POWER_MAX_RATE = 2800000
POWER_MIN_RATE = 1000000
# rtl_sdr's default USB output block in bytes; see capture_samples().
RTL_SDR_BLOCK = 16 * 16384
# The only sample rates the RTL2832U takes (librtlsdr rtlsdr_set_sample_rate).
# rtl_sdr merely WARNS when a rate is refused and records at the old one, so
# a bad UMIK_SDR_IQ_RATE would silently mislabel every clip - refuse it here.
RATE_OK = ((225001, 300000), (900001, 3200000))
# The R820T2 tunes about 24-1766 MHz; outside that rtl_* print "PLL not locked".
TUNER_MHZ = (24.0, 1766.0)

