    "mic-vid": "USB vendor IDs that count as umik-record's microphone (exit 79)",
}

# --- hardware facts -----------------------------------------------------------

RTL_IDS = ("0bda:2838", "0bda:2832")
# What usb_str() keeps of a USB string: umik-record's `tr -cd`, for the same
# reason - the strings come from the device and are untrusted.
USB_STR_OK = frozenset("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
