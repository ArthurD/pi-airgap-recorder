#!/bin/sh
# umik-diag - every boot, wait for the dust to settle, then dump the state of
# the recording stack to the Mac-readable data partition. journald on this
# box is volatile, so without this a failed unit leaves no trace after a
# power cut. This file is the trace.

set -u

sleep "${UMIK_DIAG_DELAY:-90}"

D=/data/logs
mkdir -p "$D" 2>/dev/null || exit 0
F="$D/diag-latest.log"
# Keep four boots of history, not two: the field crash-loop boot's diag was
# rotated away by the two healthy boots that followed it, destroying the
# only systemd-level evidence of what went wrong.
[ -f "$D/diag-prev2.log" ] && mv -f "$D/diag-prev2.log" "$D/diag-prev3.log" 2>/dev/null
[ -f "$D/diag-prev.log" ]  && mv -f "$D/diag-prev.log"  "$D/diag-prev2.log" 2>/dev/null
[ -f "$F" ] && mv -f "$F" "$D/diag-prev.log" 2>/dev/null

{
    echo "=== umik-diag @ $(date -u) (up $(cut -d. -f1 /proc/uptime)s, boot $(cut -c1-8 /proc/sys/kernel/random/boot_id)) ==="

    echo; echo "--- failed units ---"
    systemctl --failed --no-pager -l 2>&1

    for u in umik-radio-check umik-usb-detect umik-rtc-time umik-time-seed umik-net-time umik-gps-time umik-status umik-record umik-sdr; do
        echo; echo "--- status: $u ---"
        systemctl status "$u" --no-pager -l 2>&1
    done

    echo; echo "--- journal: umik units (this boot) ---"
    journalctl -u umik-record -u umik-sdr -u umik-radio-check -u umik-usb-detect \
               -u umik-rtc-time -u umik-net-time -u umik-gps-time -u umik-status \
               --no-pager -o short-monotonic 2>&1 | tail -150

    echo; echo "--- gps time sync (/run/umik-gps.json) ---"
    cat /run/umik-gps.json 2>/dev/null || echo "(no state file - service did not run)"

    echo; echo "--- wired ntp sync (/run/umik-net.json) ---"
    cat /run/umik-net.json 2>/dev/null || echo "(no state file - service did not run)"

    echo; echo "--- time seed (/run/umik-time-seed.json) ---"
    cat /run/umik-time-seed.json 2>/dev/null || echo "(no state file - service did not run)"

    echo; echo "--- rtc (/run/umik-rtc.json) ---"
    cat /run/umik-rtc.json 2>/dev/null || echo "(no state file - service did not run)"
    if [ -d /sys/class/rtc/rtc0 ]; then
        # since_epoch failing to read while the directory exists is the
        # DS3231's oscillator-stop flag: it halted since it was last set.
        for f in name date time since_epoch; do
            v=$(cat /sys/class/rtc/rtc0/$f 2>/dev/null) \
                && echo "rtc0/$f = $v" \
                || echo "rtc0/$f = (read failed - oscillator stopped?)"
        done
    else
        echo "(no /sys/class/rtc/rtc0 - no DS3231 fitted, or overlay missing)"
    fi

    echo; echo "--- sound cards (/proc/asound/cards) ---"
    cat /proc/asound/cards 2>/dev/null || echo "(none)"
    arecord -l 2>&1

    # The authoritative answer to "what formats/rates/channels does this mic
    # actually do" - without it a hw-params rejection is guesswork.
    echo; echo "--- usb audio capabilities (/proc/asound/card*/stream0) ---"
    for s in /proc/asound/card*/stream0; do
        [ -r "$s" ] && { echo "[$s]"; cat "$s"; }
    done

    echo; echo "--- usb devices ---"
    for d in /sys/bus/usb/devices/*/idVendor; do
        [ -r "$d" ] || continue
        p=${d%/idVendor}
        echo "  $(cat "$d"):$(cat "$p/idProduct" 2>/dev/null)  $(cat "$p/product" 2>/dev/null)"
    done

    # The RTL-SDR, if this box has one (umik-sdr). The dongle takes one user
    # at a time and rtl_test opens it, so rtl_test runs ONLY while umik-sdr is
    # down (stopped, failed, or bowed out with 79) - run while it records, it
    # would steal the dongle out from under a live session.
    echo; echo "--- sdr ---"
    lsusb -d 0bda: 2>&1 || echo "(no 0bda device on the bus)"
    for d in /sys/bus/usb/devices/*/; do
        [ "$(cat "${d}idVendor" 2>/dev/null)" = 0bda ] || continue
        case "$(cat "${d}idProduct" 2>/dev/null)" in 2838|2832)
            n=$(printf '/dev/bus/usb/%03d/%03d' "$(cat "${d}busnum")" "$(cat "${d}devnum")")
            echo "dongle node (want crw-rw---- root plugdev): $(ls -l "$n" 2>&1)" ;;
        esac
    done
    # shellcheck disable=SC2010  # usbfs node names are digits only (001/005)
    echo "usbfs device nodes: $(ls -l /dev/bus/usb/*/* 2>/dev/null | grep -c .)"
    echo "recorder: $(id recorder 2>&1)"
    echo "dvb/rtl modules loaded (want none):"
    lsmod | grep -E 'dvb|rtl28|r820t' || echo "  (none)"
    st=$(systemctl is-active umik-sdr 2>/dev/null)
    case "$st" in
        active|activating|deactivating|reloading)
            echo "rtl_test skipped: umik-sdr is ${st} and may hold the dongle" ;;
        *)  if command -v rtl_test >/dev/null 2>&1; then
                echo "rtl_test -t (umik-sdr is ${st:-unknown}):"
                timeout 20 rtl_test -t 2>&1 | head -20
            else
                echo "rtl_test not installed - SDR support not provisioned"
            fi ;;
    esac

    echo; echo "--- storage ---"
    findmnt /data /data/usb --no-pager 2>/dev/null
    df -h /data 2>/dev/null | tail -1

    echo; echo "=== end of diag ==="
} > "$F" 2>&1

sync
exit 0
