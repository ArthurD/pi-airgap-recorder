#!/bin/sh
# umik-diag - every boot, wait for the dust to settle, then dump the state of
# the recording stack to the Mac-readable data partition. journald on this
# box is volatile, so without this a failed unit leaves no trace after a
# power cut. This file is the trace.

set -u

sleep "${UMIK_DIAG_DELAY:-90}"

D=/data/logs
mkdir -p "$D" 2>/dev/null || exit 0
F="$D/diag-latest.log"
# Keep four boots of history, not two: the field crash-loop boot's diag was
# rotated away by the two healthy boots that followed it, destroying the
# only systemd-level evidence of what went wrong.
[ -f "$D/diag-prev2.log" ] && mv -f "$D/diag-prev2.log" "$D/diag-prev3.log" 2>/dev/null
[ -f "$D/diag-prev.log" ]  && mv -f "$D/diag-prev.log"  "$D/diag-prev2.log" 2>/dev/null
[ -f "$F" ] && mv -f "$F" "$D/diag-prev.log" 2>/dev/null

{
    echo "=== umik-diag @ $(date -u) (up $(cut -d. -f1 /proc/uptime)s, boot $(cut -c1-8 /proc/sys/kernel/random/boot_id)) ==="

    echo; echo "--- failed units ---"
    systemctl --failed --no-pager -l 2>&1

    for u in umik-radio-check umik-usb-detect umik-gps-time umik-record; do
        echo; echo "--- status: $u ---"
        systemctl status "$u" --no-pager -l 2>&1
    done

    echo; echo "--- journal: umik units (this boot) ---"
    journalctl -u umik-record -u umik-radio-check -u umik-usb-detect \
               -u umik-gps-time \
               --no-pager -o short-monotonic 2>&1 | tail -150

    echo; echo "--- gps time sync (/run/umik-gps.json) ---"
    cat /run/umik-gps.json 2>/dev/null || echo "(no state file - service did not run)"

    echo; echo "--- sound cards (/proc/asound/cards) ---"
    cat /proc/asound/cards 2>/dev/null || echo "(none)"
    arecord -l 2>&1

    # The authoritative answer to "what formats/rates/channels does this mic
    # actually do" - without it a hw-params rejection is guesswork.
    echo; echo "--- usb audio capabilities (/proc/asound/card*/stream0) ---"
    for s in /proc/asound/card*/stream0; do
        [ -r "$s" ] && { echo "[$s]"; cat "$s"; }
    done

    echo; echo "--- usb devices ---"
    for d in /sys/bus/usb/devices/*/idVendor; do
        [ -r "$d" ] || continue
        p=${d%/idVendor}
        echo "  $(cat "$d"):$(cat "$p/idProduct" 2>/dev/null)  $(cat "$p/product" 2>/dev/null)"
    done

    echo; echo "--- storage ---"
    findmnt /data /data/usb --no-pager 2>/dev/null
    df -h /data 2>/dev/null | tail -1

    echo; echo "=== end of diag ==="
} > "$F" 2>&1

sync
exit 0
