# umik-net-time: DHCP on the wired port, used only inside the one-time
# network window that service opens (systemd-networkd is disabled in steady
# state and started/stopped around the window). UseNTP hands any
# DHCP-advertised NTP server straight to systemd-timesyncd, which then
# works even on a LAN whose DNS or WAN is down.
[Match]
Name=eth0

[Network]
DHCP=ipv4
# Outbound-only posture: no link-local addressing (no 169.254 fallback to
# linger if DHCP fails), no IPv6 router solicitation (IPv6 is disabled by
# sysctl anyway), and no name-service responders.
LinkLocalAddressing=no
IPv6AcceptRA=no
LLMNR=no
MulticastDNS=no

[DHCPv4]
UseNTP=yes
