[Unit]
Description=Drive the onboard LEDs as a recording/clock status display
# An independent observer: deliberately NOT ordered against the recorder -
# it starts early ("green off" honestly means "recorder not up yet") and a
# failure here can never touch recording.
After=local-fs.target

[Service]
Type=simple
ExecStart=/usr/local/bin/umik-status
Restart=always
RestartSec=5

# --- sandboxing -------------------------------------------------------------
# Root for /sys/class/leds. CAP_DAC_OVERRIDE is REQUIRED, not optional:
# the recordings live in 0700 recorder-owned directories (exFAT dmask/ext4
# chmod), and root without that capability cannot traverse them - field
# symptom was green stuck on "solid" forever because the segment-growth
# check could never see the files. NOTE: ProtectKernelTunables must NOT be
# set - it remounts /sys read-only, which is exactly where the LEDs live.
NoNewPrivileges=yes
CapabilityBoundingSet=CAP_DAC_OVERRIDE
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/data

PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any

ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
UMask=0077

SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

DevicePolicy=closed

[Install]
WantedBy=multi-user.target
